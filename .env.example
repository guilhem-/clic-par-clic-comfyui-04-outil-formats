# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Modèle de conversation sur lequel repose « Atelier d'images » (il doit savoir appeler des outils).
MODELE_BASE=
# Plafond de variantes par demande (vanne de l'outil) : chaque variante est un calcul complet.
VARIANTES_MAX=3
