# Open WebUI: address and token of an administrator account (Settings > Account > API keys, or a session token).
OWUI_URL=http://127.0.0.1:8080
OWUI_TOKEN=
# Chat model the "Image workshop" model is based on (it must be able to call tools).
BASE_MODEL=
# Maximum number of variants per request (valve of the tool): each variant is a full computation.
MAX_VARIANTS=3
